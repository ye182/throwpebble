# ========== 本机开发（默认）==========
PORT=8787
HOST=0.0.0.0
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://127.0.0.1:5173
DATA_DIR=./server/data
NODE_ENV=development

# 本机开发请留空：前端走 Vite 代理 → http://127.0.0.1:8787
# VITE_API_BASE=

# 日记真实 API（可选；默认前端 mock）
# VITE_DIARY_API_BASE=

# 本地测试账号（服务启动时自动写入，若不存在）：
# 手机/邮箱 111111
# 密码 111111

# ========== 项目四 · 信件 LLM（只配在轻量服务器 .env，勿进 COS）==========
# 腾讯混元 OpenAI 兼容：https://api.hunyuan.cloud.tencent.com/v1/chat/completions
# 未配置时生成走 mock，不影响登录与其它 API。
# LLM_API_KEY=
# 或：HUNYUAN_API_KEY=
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-turbos-latest
# LLM_TIMEOUT_MS=45000

# ========== 腾讯云上线时（COS 前端 + 轻量服务器后端）==========
# 1) 轻量服务器上的后端 .env 示例：
# NODE_ENV=production
# PORT=8787
# HOST=0.0.0.0
# JWT_SECRET=<换成足够长的随机字符串>
# JWT_EXPIRES_IN=7d
# CLIENT_ORIGIN=https://你的CDN或自定义前端域名
# DATA_DIR=./server/data
# LLM_API_KEY=<混元 API Key>
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-turbos-latest
#
# 2) 构建要上传到 COS 的前端时（在本机执行），设置：
# VITE_API_BASE=http://轻量服务器公网IP:8787
# 或买域名并配好 HTTPS 后：
# VITE_API_BASE=https://api.你的域名.com
#
# 详见 DEPLOY.md
